# =====================================================================================
#  BreastFriend — configuration du backend. Copier en « .env » (jamais commité).
#  Aucun secret n'est envoyé au navigateur : toutes les clés restent côté serveur.
# =====================================================================================

# Clé de signature des sessions. Laisser vide en développement : une clé aléatoire est
# générée une fois dans data/secret_key. En production, fixer une valeur longue et secrète.
SECRET_KEY=
TOKEN_MAX_AGE=604800
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=40

# -------------------------------------------------------------------------------------
#  CONFIDENTIALITÉ
#  Avec un fournisseur DISTANT (OpenAI, Groq, Mistral…), les questions des patientes et
#  les extraits de documents sont envoyés à ce fournisseur. LOCAL_ONLY=true interdit tout
#  fournisseur distant (LLM et embeddings) : aucune donnée ne quitte la machine.
# -------------------------------------------------------------------------------------
LOCAL_ONLY=false

# =====================================================================================
#  LLM — génération des réponses.  LLM_PROVIDER = ollama | openai | openai_compatible | none
# =====================================================================================
LLM_PROVIDER=ollama

# --- Mode local : Ollama (https://ollama.com) — recommandé sous Windows -----------------
#   ollama pull qwen2.5:7b-instruct
# Choix du modèle selon la machine (quantification Q4 par défaut dans Ollama) :
#   CPU seul / 8 Go de RAM       : qwen2.5:3b-instruct ou llama3.2:3b     (lent mais utilisable)
#   GPU 6–8 Go de VRAM           : qwen2.5:7b-instruct, mistral:7b-instruct, llama3.1:8b
#   GPU 12–16 Go                 : qwen2.5:14b-instruct, mistral-nemo:12b
#   GPU 24 Go et plus            : qwen2.5:32b-instruct
#   Les modèles 70B demandent ~40 Go de VRAM : inutiles ici.
# Qwen 2.5 et Mistral sont bons en français et respectent bien les consignes de citation.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_NUM_CTX=8192

# --- Mode API : OpenAI (API « Responses ») — DONNÉES ENVOYÉES À OPENAI -------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Tout serveur compatible OpenAI (/v1/chat/completions) ------------------------------
#   vLLM :       LLM_BASE_URL=http://localhost:8000/v1   LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
#   LM Studio :  LLM_BASE_URL=http://localhost:1234/v1   LLM_MODEL=<nom du modèle chargé>
#   Groq (distant) : LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=gsk_...
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Paramètres communs. LLM_TEMPERATURE vide = non envoyé (modèles de raisonnement OpenAI).
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=900
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# =====================================================================================
#  RAG — embeddings.  EMBEDDING_PROVIDER = local | ollama | openai
#  Changer de modèle crée une nouvelle collection et réindexe automatiquement au démarrage.
# =====================================================================================
#  local  : sentence-transformers + PyTorch (pip install -r requirements-local-ml.txt)
#           BAAI/bge-m3 : multilingue (très bon en français), 1024 dimensions, ~2,3 Go.
#  ollama : même modèle bge-m3 servi par Ollama, SANS PyTorch :  ollama pull bge-m3
#  openai : text-embedding-3-small (1536 dim.) — DONNÉES ENVOYÉES À OPENAI
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=16
# Préfixes à renseigner seulement pour les modèles qui en exigent (ex. multilingual-e5 :
# « query: » / « passage: »). bge-m3 n'en a pas besoin.
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# =====================================================================================
#  RAG — base vectorielle.  VECTOR_DB = qdrant | local
# =====================================================================================
#  Qdrant serveur (Docker) :  docker compose up -d qdrant   puis  QDRANT_URL=http://localhost:6333
#  Qdrant embarqué (sans Docker, un seul processus) : laisser QDRANT_URL vide -> données dans QDRANT_PATH
#  local : SQLite + NumPy (dépannage / petits corpus)
VECTOR_DB=qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=
QDRANT_COLLECTION_PREFIX=breastfriend

# =====================================================================================
#  RAG — découpage, recherche, reranking
# =====================================================================================
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RAG_HYBRID=true
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=6
RAG_CONTEXT_MAX_TOKENS=3500
# Seuils de pertinence : à calibrer avec « python -m rag.evaluate » pour votre modèle.
# Sans reranker, bge-m3 donne ~0,45–0,55 aux passages vaguement liés : monter à ~0,5.
RAG_MIN_VECTOR_SCORE=0.35
RAG_MIN_RERANK_SCORE=0.15
# Reranker cross-encodeur multilingue (~2,3 Go). false sur une machine lente :
# la fusion vecteurs + BM25 est alors utilisée telle quelle.
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_LENGTH=1024
# Affiche les scores de recherche dans l'interface médecin
RAG_DEBUG=false
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_MAX_CHARS=4000
RAG_AUTO_SYNC=true

# =====================================================================================
#  OCR des PDF scannés (Tesseract + Poppler, voir README). Langue « fra » à installer.
# =====================================================================================
OCR_ENABLED=true
OCR_LANG=fra+eng
OCR_DPI=200
